---
import Base from "../layouts/Base.astro";
import { plans, waHref } from "../data/site";
---

<Base
  title="Plans"
  description="Billing ERP plans: Starter, Professional, Business, and Enterprise. Monthly prices in rupees, with a yearly option."
>
  <section class="section">
    <div class="section-head">
      <span class="index-label">Plans</span>
      <div>
        <h1 class="h1" style="font-size: clamp(3rem, 6vw, 5.4rem);">Start at the counter. <em>Open the rest when you need it.</em></h1>
        <p class="lede" style="margin-top: 1.1rem;">
          Prices are per business, in rupees. A year is billed as ten months. If you are between two plans, write to us with the modules you want on day one.
        </p>
      </div>
    </div>
    <div class="paper-plans">
      {
        plans.map((plan) => (
          <article class="paper-plan">
            <div>
              <h2>
                {plan.name}
                {plan.featured ? " ·" : ""}
              </h2>
              <p class="tag">{plan.tagline}</p>
            </div>
            <div>
              <div class="phone-xl" style="font-size: clamp(1.8rem, 3vw, 2.6rem);">{plan.price}</div>
              <p class="tag">{plan.cadence}</p>
              <p class="tag">{plan.yearly}</p>
            </div>
            <ul class="plan-features" style="color: inherit;">
              {plan.features.map((feature) => (
                <li>{feature}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
    <p style="margin-top: 2rem;">
      <a class="header-cta" href={waHref}>Talk through a plan</a>
    </p>
  </section>
</Base>
